# =========================================================================
# CEPA · Variables de entorno
# Copia este archivo como .env.local y completa con los datos de tu proyecto
# Supabase (Dashboard → Project Settings → API). NO subas .env.local a git.
# =========================================================================

# URL del proyecto (ej. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon / publishable). Para el cliente y el login (próximo milestone).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role — SOLO servidor. NUNCA la expongas al cliente.
# El panel admin la usa para leer la data en Server Components.
SUPABASE_SERVICE_ROLE_KEY=
